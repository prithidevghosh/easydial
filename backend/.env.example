# Copy to .env locally. Never paste secrets into chat or commit this file's filled copy.
OPENAI_API_KEY=
# Baseline models are configurable; validate account access before switching models.
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
COMMERCE_MODE=live
# Live provider carts; checkout only marks payment pending. Single-operator local validation.
INSTAMART_BROWSER_PROFILE=
INSTAMART_VERIFIED_ADDRESS=
INSTAMART_VERIFIED_LOCATION=
BLINKIT_BROWSER_PROFILE=
LIVE_ADDRESS_LABEL=
BLINKIT_STORAGE_STATE=
BLINKIT_VERIFIED_ADDRESS=
BLINKIT_VERIFIED_LOCATION=
