# Copy to .env locally. Never paste secrets into chat or commit this file's filled copy.
OPENAI_API_KEY=
# Baseline models are configurable; validate account access before switching models.
OPENAI_TEXT_MODEL=gpt-4.1
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_SPEECH_MODEL=gpt-4o-mini-tts
OPENAI_VOICE=coral
COMMERCE_MODE=live
# Live provider carts; checkout only marks payment pending. Single-operator local validation.
INSTAMART_BROWSER_PROFILE=
INSTAMART_VERIFIED_ADDRESS=
INSTAMART_VERIFIED_LOCATION=
BLINKIT_BROWSER_PROFILE=
LIVE_ADDRESS_LABEL=
BLINKIT_STORAGE_STATE=
BLINKIT_VERIFIED_ADDRESS=
BLINKIT_VERIFIED_LOCATION=

# WhatsApp single-user pilot. Run tools/connect_whatsapp.py for private prompts.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Your testing WhatsApp number, country code + digits, WITHOUT the '+' (only one user).
WHATSAPP_ALLOWED_SENDER=
WHATSAPP_SUPPORT_CONTACT=
WHATSAPP_API_VERSION=v27.0
WHATSAPP_DATABASE=.state/whatsapp/pilot.sqlite3

# Optional deployment mode; keep headed for manual login/recovery.
BROWSER_HEADLESS=false
BROWSER_CHANNEL=chrome

# HTTPS origin hosting the WhatsApp server; payment links expire in minutes.
WHATSAPP_PUBLIC_URL=

# Optional Blinkit-specific override; headed mode is required for this pilot profile.
BLINKIT_BROWSER_HEADLESS=false

# Customer onboarding pilot. Use a NEW database; never reuse the single-user pilot DB.
WHATSAPP_MULTIUSER=false
# Public WhatsApp number in international digits (not the Meta phone-number ID).
WHATSAPP_BUSINESS_NUMBER=
# Generate once with tools/setup_customer_onboarding.py. Keep outside Git; back up securely.
CUSTOMER_SESSION_KEY=
CUSTOMER_SESSION_DIRECTORY=.state/customers
ONBOARDING_MAX_CUSTOMERS=100
